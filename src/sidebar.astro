---
import data from 'blume:data';
import Icon from 'blume/components/Icon.astro';
import NavTree from 'blume/components/layout/NavTree.astro';
import type { UIStrings } from 'blume/core/i18n-ui.ts';
import { EN_UI } from 'blume/core/i18n-ui.ts';
import type { NavNode } from 'blume/core/types.ts';

interface Props {
	currentRoute: string;
	fragmentBase?: string;
	ids?: Map<NavNode, string>;
	items: NavNode[];
	strings?: UIStrings['nav'];
	version?: string;
	changelog?: string;
	repository?: string;
}

const props = Astro.props;
const labels = { ...EN_UI.nav, ...props.strings };

// Ctrl/Cmd+K and the dialog stay owned by Blume's own search trigger; this button only forwards to it.
const forwardSearchScript = `(()=>{if(window.__presetSidebarSearch){return;}window.__presetSidebarSearch=true;document.addEventListener("click",(e)=>{if(!e.target.closest("[data-preset-search-open]")){return;}const trigger=document.querySelector("[data-blume-search-open]");if(!trigger){throw new Error("Blume search trigger not found");}trigger.click();});})();`;

const hasTools = data.config.search.enabled || data.config.theme.toggle;
const hasLinks = Boolean(props.version || props.repository);
---

<NavTree
	currentRoute={props.currentRoute}
	fragmentBase={props.fragmentBase}
	ids={props.ids}
	items={props.items}
	strings={props.strings}
/>
<div data-preset-sidebar-footer>
	{
		props.version &&
			(props.changelog ? (
				<a href={props.changelog}>v{props.version}</a>
			) : (
				<span>v{props.version}</span>
			))
	}
	{props.version && props.repository && <span aria-hidden="true">&middot;</span>}
	{
		props.repository && (
			<a
				href={props.repository}
				aria-label="GitHub repository"
				target="_blank"
				rel="noreferrer"
			>
				<svg
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="1.5"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"
				>
					<path d="M10 20.5675C6.57143 21.7248 3.71429 20.5675 2 17" />
					<path d="M10 22V18.7579C10 18.1596 10.1839 17.6396 10.4804 17.1699C10.6838 16.8476 10.5445 16.3904 10.1771 16.2894C7.13394 15.4528 5 14.1077 5 9.64606C5 8.48611 5.38005 7.39556 6.04811 6.4464C6.21437 6.21018 6.29749 6.09208 6.31748 5.9851C6.33746 5.87813 6.30272 5.73852 6.23322 5.45932C5.95038 4.32292 5.96871 3.11619 6.39322 2.02823C6.39322 2.02823 7.27042 1.74242 9.26698 2.98969C9.72282 3.27447 9.95075 3.41686 10.1515 3.44871C10.3522 3.48056 10.6206 3.41384 11.1573 3.28041C11.8913 3.09795 12.6476 3 13.5 3C14.3524 3 15.1087 3.09795 15.8427 3.28041C16.3794 3.41384 16.6478 3.48056 16.8485 3.44871C17.0493 3.41686 17.2772 3.27447 17.733 2.98969C19.7296 1.74242 20.6068 2.02823 20.6068 2.02823C21.0313 3.11619 21.0496 4.32292 20.7668 5.45932C20.6973 5.73852 20.6625 5.87813 20.6825 5.9851C20.7025 6.09207 20.7856 6.21019 20.9519 6.4464C21.6199 7.39556 22 8.48611 22 9.64606C22 14.1077 19.8661 15.4528 16.8229 16.2894C16.4555 16.3904 16.3162 16.8476 16.5196 17.1699C16.8161 17.6396 17 18.1596 17 18.7579V22" />
				</svg>
			</a>
		)
	}
	{
		hasTools && (
			<span data-preset-sidebar-tools>
				{hasLinks && <span aria-hidden="true">&middot;</span>}
				{
					data.config.search.enabled && (
						<button type="button" data-preset-search-open aria-label="Search">
							<Icon name="search" size={18} />
						</button>
					)
				}
				{data.config.search.enabled && data.config.theme.toggle && <span aria-hidden="true">&middot;</span>}
				{
					data.config.theme.toggle && (
						<button
							type="button"
							data-blume-theme-toggle
							aria-label={labels.toggleTheme}
						>
							<span data-preset-icon-light>
								<Icon name="sun" size={18} />
							</span>
							<span data-preset-icon-dark>
								<Icon name="moon" size={18} />
							</span>
						</button>
					)
				}
			</span>
		)
	}
</div>
<script is:inline set:html={forwardSearchScript} />
