		"check:lint": "biome lint .",
		"format": "biome check --write"
	},
	"dependencies": {
		"@base-ui/react": "^1.9.0"
	},
	"peerDependencies": {
		"blume": "^2.1.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.15",
		"@total-typescript/tsconfig": "^1.0.4",
		"@types/node": "^26.6.4",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"blume": "^2.1.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"typescript": "^5.7.2"
	}
}
