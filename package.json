{
	"name": "@fdarian/blume-preset",
	"version": "0.1.0",
	"private": true,
	"description": "Shared Blume docs look and behavior: theme, config defaults and the chapter rail.",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@12.9.0",
	"exports": {
		".": "./src/index.ts",
