{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"formatter": {
		"indentStyle": "tab"
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single"
		}
	},
	"markdown": { "parser": { "frontmatter": true } },
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"correctness": { "noUnusedImports": { "level": "warn", "fix": "safe" } }
		}
	},
	"overrides": [
		{
			// Biome only reads the frontmatter, so imports used in the template look unused and get removed
			"includes": ["**/*.astro"],
			"linter": { "rules": { "correctness": { "noUnusedImports": "off" } } }
		}
	],
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
